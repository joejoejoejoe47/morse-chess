# Copy to .env and fill in. Real environment variables win over this file.

# --- MySQL / MariaDB (default) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=morse_chess
DB_USER=morse
DB_PASS=change-me
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# --- or SQLite: zero setup, fine for a small club ---
# DB_DRIVER=sqlite
# DB_SQLITE=storage/morse.sqlite

# Public origin, e.g. https://chess.example.com (optional; derived from the request if unset)
# APP_URL=https://chess.example.com
# Extra origins allowed to call the API (comma separated, optional)
# TRUSTED_ORIGINS=
# Set to 1 to show exception messages in 500 responses while debugging
APP_DEBUG=0
