<?xml version="1.0" encoding="utf-8"?>
<!-- IIS (Windows hosting): send everything that is not a real file to index.php. Needs the URL Rewrite module. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <!-- App pages that share a name with an asset folder (sandbox/, club/, boards/, history/):
             without this IIS answers /chess/sandbox with a 301 to http://.../sandbox/ and then a 403. -->
        <rule name="Morse app pages over folders" stopProcessing="true">
          <match url="^(sandbox|club|boards|history|soundtrack)/?$" />
          <action type="Rewrite" url="index.php" />
        </rule>
        <rule name="Morse router" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
      <!-- Models and sounds are requested with their content hash (?v=...), so a URL never changes
           meaning: let browsers and Cloudflare keep them for a year. Unversioned requests are untouched. -->
      <outboundRules>
        <rule name="Cache versioned models and sounds" preCondition="Model or sound">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)v=[0-9a-f]{8}($|&amp;)" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <preConditions>
          <preCondition name="Model or sound">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^(model/gltf-binary|audio/mpeg)" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".glb" /><mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <remove fileExtension=".gltf" /><mimeMap fileExtension=".gltf" mimeType="model/gltf+json" />
      <remove fileExtension=".webmanifest" /><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".fbx" /><mimeMap fileExtension=".fbx" mimeType="application/octet-stream" />
      <remove fileExtension=".bin" /><mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
      <remove fileExtension=".hdr" /><mimeMap fileExtension=".hdr" mimeType="application/octet-stream" />
      <remove fileExtension=".md" /><mimeMap fileExtension=".md" mimeType="text/markdown" />
      <remove fileExtension=".wasm" /><mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".mp3" /><mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
    </staticContent>
  </system.webServer>
</configuration>
